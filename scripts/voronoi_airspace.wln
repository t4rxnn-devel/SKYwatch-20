(* SkyWatch-20 Sector Geometry Voronoi Matrix *)
(* Maps control boundaries around live fleet positions *)

ClearAll[computeAirspaceSectors];

computeAirspaceSectors[] := Module[
    {aircraftPositions, voronoiMesh, sectorAreas},
    
    (* Native tracking coordinates vector array parsed from live fleet *)
    aircraftPositions = {
        {-15.0, -15.0}, (* UAL104 *)
        {15.0, 15.0},   (* AAL892 *)
        {-18.0, 10.0}   (* DAL440 *)
    };
    
    (* Generate spatial cell mesh divisions natively *)
    voronoiMesh = VoronoiMesh[aircraftPositions, {{-25, 25}, {-25, 25}}];
    
    (* Extract calculated numerical areas per flight control zone *)
    sectorAreas = PropertyValue[{voronoiMesh, 2}, MeshCellMeasure];
    
    Print["=== SPATIAL SECTOR DIVISION COMPLETE ==="];
    Print["Tracked Fleet Positions Seeded: ", aircraftPositions];
    Print["Calculated Control Cell Sector Areas (Square NM): ", sectorAreas];
];

computeAirspaceSectors[];
